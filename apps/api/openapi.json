            "type": "string"
          },
          "label": {
            "title": "Label",
            "type": "string"
          },
          "value": {
            "title": "Value",
            "type": "string"
          }
        },
        "required": [
          "display",
          "value",
          "category",
          "label"
        ],
        "title": "SuggestItem",
        "type": "object"
      },
      "TechniqueRef": {
        "properties": {
          "confidence": {
            "title": "Confidence",
            "type": "integer"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "tactic": {
            "items": {
              "type": "string"
            },
            "title": "Tactic",
            "type": "array"
          },
          "technique_id": {
            "title": "Technique Id",
            "type": "string"
          },
          "technique_name": {
            "title": "Technique Name",
            "type": "string"
          }
        },
        "required": [
          "technique_id",
          "technique_name",
          "id",
          "name",
          "tactic",
          "confidence"
