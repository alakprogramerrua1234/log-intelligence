{
  "components": {
    "schemas": {
      "DetectionOut": {
        "description": "One detection row, denormalized for the frontend Log type.",
        "properties": {
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "event_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Event Id"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "log_source_id": {
            "title": "Log Source Id",
            "type": "string"
          },
          "log_source_name": {
            "title": "Log Source Name",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "provider": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Provider"
          },
          "relevance": {
            "default": 0,
            "title": "Relevance",
            "type": "integer"
          },
          "sample_fields": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sample Fields"
          },
          "techniques": {
            "items": {
              "$ref": "#/components/schemas/TechniqueRef"
            },
            "title": "Techniques",
            "type": "array"
          }
        },
        "required": [
          "id",
          "log_source_id",
          "log_source_name",
          "event_id",
          "name",
          "techniques"
        ],
        "title": "DetectionOut",
        "type": "object"
      },
      "ErrorOut": {
        "description": "Forma estándar de error de la API (ARCHITECTURE.md §3).\n\nNunca se devuelve 200 con un error dentro. `code` es estable y pensado para\nque el cliente ramifique sobre él; `detail` es para humanos.",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "keys": {
            "items": {
              "type": "string"
            },
            "title": "Keys",
            "type": "array"
          }
        },
        "required": [
          "detail",
          "code"
        ],
        "title": "ErrorOut",
        "type": "object"
      },
      "FilterCategoryOut": {
        "properties": {
          "detection_fk": {
            "title": "Detection Fk",
