          },
          "enabled": {
            "title": "Enabled",
            "type": "boolean"
          },
          "key": {
            "title": "Key",
            "type": "string"
          },
          "label": {
            "title": "Label",
            "type": "string"
          },
          "order": {
            "title": "Order",
            "type": "integer"
          },
          "source_table": {
            "title": "Source Table",
            "type": "string"
          },
          "ui_hint": {
            "title": "Ui Hint",
            "type": "string"
          },
          "value_column": {
            "title": "Value Column",
            "type": "string"
          },
          "value_type": {
            "title": "Value Type",
            "type": "string"
          }
        },
        "required": [
          "key",
          "label",
          "source_table",
          "value_column",
          "detection_fk",
          "value_type",
          "ui_hint",
          "order",
          "enabled"
        ],
        "title": "FilterCategoryOut",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "PaginatedDetections": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/DetectionOut"
            },
            "title": "Items",
            "type": "array"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          },
          "total": {
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "items",
          "total"
        ],
        "title": "PaginatedDetections",
        "type": "object"
      },
      "SuggestItem": {
        "properties": {
          "category": {
            "title": "Category",
            "type": "string"
          },
          "display": {
